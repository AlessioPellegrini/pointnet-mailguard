msgstr "i termini di Google"

msgid "For full GDPR compliance use a paid Google Cloud account which includes a Data Processing Agreement."
msgstr "Per la piena conformità GDPR utilizza un account Google Cloud a pagamento che include un Data Processing Agreement."

# Export / Support tab
msgid "Export Diagnostic Report"
msgstr "Esporta Report Diagnostico"

msgid "Download a complete JSON report with all scan data, DNS configuration and settings. Share it with PointNet support or an external AI for troubleshooting."
msgstr "Scarica un report JSON completo con tutti i dati di scansione, configurazione DNS e impostazioni. Condividilo con il supporto PointNet o un'AI esterna per il troubleshooting."

msgid "Privacy notice:"
msgstr "Avviso privacy:"

